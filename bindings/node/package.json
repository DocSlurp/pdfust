{
  "name": "@docslurp/pdfust",
  "version": "0.13.0",
  "description": "In-process Node.js binding (N-API) for the pdfust Rust PDF engine: text, Markdown, tables, rendering and OCR",
  "license": "MIT",
  "author": "Yusuke Hayashi <yusuke8h@gmail.com>",
  "homepage": "https://github.com/DocSlurp/pdfust/tree/main/bindings/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocSlurp/pdfust.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/DocSlurp/pdfust/issues"
  },
  "keywords": [
    "pdf",
    "pdf-extraction",
    "markdown",
    "ocr",
    "napi",
    "rust"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "pdfust-node.*.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "napi": {
    "binaryName": "pdfust-node",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "test": "node --expose-gc --test test/"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
